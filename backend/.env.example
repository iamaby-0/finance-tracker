# Backend Server Configuration
PORT=3000

# MongoDB Database Connection
DB_NAME=finance-tracker
DB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/finance-tracker?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Groq Cloud AI API Key (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google OAuth 2.0 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/aft/api/v1/auth/google/callback

# Frontend Application Origin (for CORS & redirects)
FRONTEND_URL=http://localhost:5173
